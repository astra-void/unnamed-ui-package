{
  "internalScope": "@lattice-ui",
  "internalDependencyVersion": "workspace:*",
  "lockedVersion": "0.8.1",
  "lockedstep": {
    "enforced": true,
    "major": 0
  },
  "packageDefaults": {
    "private": false,
    "main": "out/init.luau",
    "types": "out/index.d.ts",
    "source": "src/index.ts",
    "files": [
      "default.project.json",
      "out",
      "src",
      "README.md"
    ],
    "repository": {
      "type": "git",
      "url": "https://github.com/astra-void/lattice-ui.git"
    },
    "scripts": {
      "build": "rbxtsc -p tsconfig.json",
      "lint": "biome check src",
      "lint:fix": "biome check src --write --unsafe",
      "typecheck": "tsc -p tsconfig.typecheck.json",
      "watch": "rbxtsc -p tsconfig.json -w"
    }
  },
  "layers": {
    "core": {
      "tsconfigBase": "tsconfig.base.json",
      "peerDependencies": {},
      "devDependencies": {}
    },
    "react": {
      "tsconfigBase": "tsconfig.react.json",
      "peerDependencies": {
        "@rbxts/react": "^17.3.7-ts.1",
        "@rbxts/react-roblox": "^17.3.7-ts.1"
      },
      "devDependencies": {
        "@rbxts/react": "17.3.7-ts.1",
        "@rbxts/react-roblox": "17.3.7-ts.1"
      }
    },
    "vide": {
      "tsconfigBase": "tsconfig.vide.json",
      "hoistedLinks": true,
      "peerDependencies": {
        "@rbxts/vide": "^0.6.1"
      },
      "devDependencies": {
        "@rbxts/vide": "0.6.1"
      }
    }
  },
  "toolingPackages": [
    "lattice-ui"
  ],
  "requiredFiles": [
    "default.project.json",
    "src/index.ts",
    "tsconfig.json",
    "tsconfig.typecheck.json"
  ],
  "changesets": {
    "baseBranch": "main",
    "access": "public"
  }
}
