{
  "name": "@lattice-ui/vide-radio-group",
  "version": "0.8.1",
  "private": false,
  "main": "out/init.luau",
  "types": "out/index.d.ts",
  "source": "src/index.ts",
  "files": [
    "default.project.json",
    "out",
    "src",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/astra-void/lattice-ui.git"
  },
  "scripts": {
    "build": "rbxtsc -p tsconfig.json",
    "lint": "biome check src",
    "lint:fix": "biome check src --write --unsafe",
    "prebuild": "node ./scripts/ensure-hoisted-links.mjs",
    "prewatch": "node ./scripts/ensure-hoisted-links.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "watch": "rbxtsc -p tsconfig.json -w"
  },
  "dependencies": {
    "@lattice-ui/core-radio-group": "workspace:*",
    "@lattice-ui/vide-focus": "workspace:*",
    "@lattice-ui/vide-motion": "workspace:*",
    "@lattice-ui/vide-runtime": "workspace:*"
  },
  "devDependencies": {
    "@rbxts/vide": "0.6.1"
  },
  "peerDependencies": {
    "@rbxts/vide": "^0.6.1"
  }
}
